{
	"name": "dataflow_demo4",
	"properties": {
		"folder": {
			"name": "demo_4"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzureBlobStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "SrcDatewiseLoad"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "Snowflake1",
						"type": "LinkedServiceReference"
					},
					"name": "sinDatewiseLoad"
				}
			],
			"transformations": [],
			"scriptLines": [
				"parameters{",
				"     df_container as string,",
				"     df_folder as string",
				"}",
				"source(useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: ($df_container),",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: false,",
				"     wildcardPaths:[(concat($df_folder,'/','*.csv'))]) ~> SrcDatewiseLoad",
				"SrcDatewiseLoad sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     tableName: 'MONEY_LOAD',",
				"     schemaName: 'STAGING',",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     recreate: true,",
				"     store: 'snowflake',",
				"     store: 'snowflakeV2',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true) ~> sinDatewiseLoad"
			]
		}
	}
}