{
	"name": "dataflow_demo4",
	"properties": {
		"folder": {
			"name": "demo_4"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "source1"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "Snowflake1",
						"type": "LinkedServiceReference"
					},
					"name": "sinDatewiseLoad"
				}
			],
			"transformations": [],
			"scriptLines": [
				"parameters{",
				"     df_container as string,",
				"     df_folder as string",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> source1",
				"source1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     tableName: 'MONEY_LOAD',",
				"     schemaName: 'STAGING',",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     recreate: true,",
				"     store: 'snowflake',",
				"     store: 'snowflakeV2',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true) ~> sinDatewiseLoad"
			]
		}
	}
}