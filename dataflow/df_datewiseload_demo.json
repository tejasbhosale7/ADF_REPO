{
	"name": "df_datewiseload_demo",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dsrc_datewiseload_demo",
						"type": "DatasetReference"
					},
					"name": "srcBlob"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "Snowflake1",
						"type": "LinkedServiceReference"
					},
					"name": "snkSnf"
				}
			],
			"transformations": [],
			"scriptLines": [
				"parameters{",
				"     pFolderPath as string (toString(currentUTC(),'yyyyMMdd'))",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['*.csv']) ~> srcBlob",
				"srcBlob sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     tableName: 'MONEY_LOAD',",
				"     schemaName: 'STAGING',",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     recreate: true,",
				"     store: 'snowflake',",
				"     store: 'snowflakeV2',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true) ~> snkSnf"
			]
		}
	}
}