{
	"name": "dataflow_demo_4",
	"properties": {
		"folder": {
			"name": "demo_4"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dsrc_datewiseload_demo",
						"type": "DatasetReference"
					},
					"name": "srcDatewiseLoad"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "Snowflake1",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "dsin_datewiseload_demo",
						"type": "DatasetReference"
					},
					"name": "snkDatewiseLoad"
				}
			],
			"transformations": [],
			"scriptLines": [
				"parameters{",
				"     pFolderPath as string",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['$pFolderPath/*.csv']) ~> srcDatewiseLoad",
				" sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     tableName: 'MONEY_LOAD',",
				"     schemaName: 'STAGING',",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     store: 'snowflake',",
				"     store: 'snowflakeV2',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true) ~> sink1",
				"srcDatewiseLoad sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true) ~> snkDatewiseLoad"
			]
		}
	}
}