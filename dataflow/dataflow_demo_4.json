{
	"name": "dataflow_demo_4",
	"properties": {
		"folder": {
			"name": "demo_4"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dsrc_datewiseload_demo",
						"type": "DatasetReference"
					},
					"name": "srcDatewiseLoad"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dsin_datewiseload_demo",
						"type": "DatasetReference"
					},
					"name": "snkDatewiseLoad"
				}
			],
			"transformations": [],
			"scriptLines": [
				"parameters{",
				"     pFolderPath as string",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:[(concat($pFolderPath,'/*.csv'))]) ~> srcDatewiseLoad",
				"srcDatewiseLoad sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true) ~> snkDatewiseLoad"
			]
		}
	}
}