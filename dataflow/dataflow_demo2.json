{
	"name": "dataflow_demo2",
	"properties": {
		"folder": {
			"name": "demo_2"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dsrc_json_demo2",
						"type": "DatasetReference"
					},
					"name": "SrcMoviesJSON"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dsrc_snf_demo2",
						"type": "DatasetReference"
					},
					"name": "SinkMoviesJSON"
				}
			],
			"transformations": [
				{
					"name": "FlattenJSON"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          date as string,",
				"          movies as (Title as string, Year as string, Rated as string, Released as string, Runtime as string, Genre as string, Director as string, Writer as string, Actors as string, Plot as string, Language as string, Country as string, Awards as string, Poster as string, Ratings as (Source as string, Value as string)[], Metascore as string, imdbRating as string, imdbVotes as string, imdbID as string, Type as string, DVD as string, BoxOffice as string, Production as string, Website as string, Response as string)[]",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'singleDocument') ~> SrcMoviesJSON",
				"SrcMoviesJSON foldDown(unroll(movies.Ratings, movies),",
				"     mapColumn(",
				"          movies",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> FlattenJSON",
				"FlattenJSON derive(ExtDttm = currentTimestamp()) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as decimal(38,0),",
				"          BOOK_ID as decimal(38,0),",
				"          BEST_BOOK_ID as decimal(38,0),",
				"          WORK_ID as decimal(38,0),",
				"          BOOKS_COUNT as decimal(38,0),",
				"          ISBN as string,",
				"          ISBN13 as double,",
				"          AUTHORS as string,",
				"          ORIGINAL_PUBLICATION_YEAR as decimal(38,1),",
				"          ORIGINAL_TITLE as string,",
				"          TITLE as string,",
				"          LANGUAGE_CODE as string,",
				"          AVERAGE_RATING as decimal(38,2),",
				"          RATINGS_COUNT as decimal(38,0),",
				"          WORK_RATINGS_COUNT as decimal(38,0),",
				"          WORK_TEXT_REVIEWS_COUNT as decimal(38,0),",
				"          RATINGS_1 as decimal(38,0),",
				"          RATINGS_2 as decimal(38,0),",
				"          RATINGS_3 as decimal(38,0),",
				"          RATINGS_4 as decimal(38,0),",
				"          RATINGS_5 as decimal(38,0),",
				"          IMAGE_URL as string,",
				"          SMALL_IMAGE_URL as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true) ~> SinkMoviesJSON"
			]
		}
	}
}