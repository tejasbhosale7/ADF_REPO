{
	"name": "dataflow_demo1",
	"properties": {
		"folder": {
			"name": "demo_1"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dsrc_csv_ingest",
						"type": "DatasetReference"
					},
					"name": "srccsvinput"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dsin_sql_df_demo",
						"type": "DatasetReference"
					},
					"name": "tgtcsvoutput"
				},
				{
					"dataset": {
						"referenceName": "dsin_sql_df_demo_1",
						"type": "DatasetReference"
					},
					"name": "TgtAllCols"
				}
			],
			"transformations": [
				{
					"name": "SelectCols"
				},
				{
					"name": "AggCapacityOutlay"
				},
				{
					"name": "SelectAllCols"
				},
				{
					"name": "InsertTS"
				}
			],
			"scriptLines": [
				"source(output(",
				"          State as string,",
				"          Year as short,",
				"          {Totals.Capital outlay} as integer,",
				"          {Totals.Revenue} as integer,",
				"          {Totals.Expenditure} as integer,",
				"          {Totals.General expenditure} as integer,",
				"          {Totals.General revenue} as integer,",
				"          {Totals.Insurance trust  revenue} as integer,",
				"          {Totals.Intergovernmental} as integer,",
				"          {Totals.License tax} as integer,",
				"          {Totals.Selective sales tax} as integer,",
				"          {Totals.Tax} as integer,",
				"          {Details.Correction.Correction Total} as integer,",
				"          {Details.Education.Education Total} as integer,",
				"          {Details.Financial Aid.Assistance and Subsidies} as integer,",
				"          {Details.Financial Aid.Cash and Securities Total} as integer,",
				"          {Details.Health.Health Total Expenditure} as integer,",
				"          {Details.Intergovernmental.Intergovernmental Expenditure} as integer,",
				"          {Details.Intergovernmental.Intergovernmental to Combined and Unallocable} as integer,",
				"          {Details.Natural Resources.Natural Resources Construction} as integer,",
				"          {Details.Utilities.Utilities Current Operation} as integer,",
				"          {Details.Welfare.Welfare Institution Total Expenditure} as integer,",
				"          {Details.Natural Resources.Parks.Parks Total Expenditure} as integer,",
				"          {Details.Transportation.Highways.Highways Total Expenditure} as integer,",
				"          {Totals. Debt at end of fiscal year} as integer,",
				"          {Details.Insurance benefits and repayments} as integer,",
				"          {Details.Interest on debt} as integer,",
				"          {Details.Interest on general debt} as integer,",
				"          {Details.Miscellaneous general revenue} as integer,",
				"          {Details.Other taxes} as integer,",
				"          {Details.Police protection} as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srccsvinput",
				"srccsvinput select(mapColumn(",
				"          Year,",
				"          {Totals.Capital outlay}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectCols",
				"SelectCols aggregate(groupBy(Year),",
				"     TotalCapacityOutlay = sum({Totals.Capital outlay})) ~> AggCapacityOutlay",
				"srccsvinput select(mapColumn(",
				"          State,",
				"          Year,",
				"          Capital_outlay = {Totals.Capital outlay},",
				"          Revenue = {Totals.Revenue},",
				"          Expenditure = {Totals.Expenditure},",
				"          General_expenditure = {Totals.General expenditure},",
				"          General_revenue = {Totals.General revenue},",
				"          Insurance_trust_revenue = {Totals.Insurance trust  revenue},",
				"          Intergovernmental = {Totals.Intergovernmental},",
				"          Totals_License_tax = {Totals.License tax},",
				"          Selective_sales_tax = {Totals.Selective sales tax},",
				"          Totals_Tax = {Totals.Tax},",
				"          Correction_Total = {Details.Correction.Correction Total},",
				"          Education_Total = {Details.Education.Education Total},",
				"          Assistance_and_Subsidies = {Details.Financial Aid.Assistance and Subsidies},",
				"          Cash_and_Securities_Total = {Details.Financial Aid.Cash and Securities Total},",
				"          Health_Total_Expenditure = {Details.Health.Health Total Expenditure},",
				"          Intergovernmental_Expenditure = {Details.Intergovernmental.Intergovernmental Expenditure},",
				"          Intergovernmental_to_Combined_and_Unallocable = {Details.Intergovernmental.Intergovernmental to Combined and Unallocable},",
				"          Natural_Resources_Construction = {Details.Natural Resources.Natural Resources Construction},",
				"          Utilities_Current_Operation = {Details.Utilities.Utilities Current Operation},",
				"          Welfare_Institution_Total_Expenditure = {Details.Welfare.Welfare Institution Total Expenditure},",
				"          Parks_Total_Expenditure = {Details.Natural Resources.Parks.Parks Total Expenditure},",
				"          Highways_Total_Expenditure = {Details.Transportation.Highways.Highways Total Expenditure},",
				"          Debt = {Totals. Debt at end of fiscal year},",
				"          Insurance_benefits_and_repayments = {Details.Insurance benefits and repayments},",
				"          Interest_on_debt = {Details.Interest on debt},",
				"          Interest_on_general_debt = {Details.Interest on general debt},",
				"          Miscellaneous_general_revenue = {Details.Miscellaneous general revenue},",
				"          Other_taxes = {Details.Other taxes},",
				"          Police_protection = {Details.Police protection}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectAllCols",
				"SelectAllCols derive(ExtDttm = currentTimestamp()) ~> InsertTS",
				"AggCapacityOutlay sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Year,",
				"          TotalCapacityOutlay",
				"     )) ~> tgtcsvoutput",
				"InsertTS sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          State,",
				"          Year,",
				"          Capital_outlay,",
				"          Revenue,",
				"          Expenditure,",
				"          General_expenditure,",
				"          General_revenue,",
				"          Insurance_trust_revenue,",
				"          Intergovernmental,",
				"          Totals_License_tax,",
				"          Selective_sales_tax,",
				"          Totals_Tax,",
				"          Correction_Total,",
				"          Education_Total,",
				"          Assistance_and_Subsidies,",
				"          Cash_and_Securities_Total,",
				"          Health_Total_Expenditure,",
				"          Intergovernmental_Expenditure,",
				"          Intergovernmental_to_Combined_and_Unallocable,",
				"          Natural_Resources_Construction,",
				"          Utilities_Current_Operation,",
				"          Welfare_Institution_Total_Expenditure,",
				"          Parks_Total_Expenditure,",
				"          Highways_Total_Expenditure,",
				"          Debt,",
				"          Insurance_benefits_and_repayments,",
				"          Interest_on_debt,",
				"          Interest_on_general_debt,",
				"          Miscellaneous_general_revenue,",
				"          Other_taxes,",
				"          Police_protection,",
				"          ExtDttm",
				"     )) ~> TgtAllCols"
			]
		}
	}
}