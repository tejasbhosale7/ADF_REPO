{
	"name": "pl_datewise_loading_demo",
	"properties": {
		"activities": [
			{
				"name": "df_datewise_load",
				"type": "ExecuteDataFlow",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "dataflow_demo4",
						"type": "DataFlowReference",
						"datasetParameters": {
							"SrcDatewiseLoad": {
								"FolderPath": {
									"value": "@formatDateTime(utcNow(), 'yyyyMMdd')",
									"type": "Expression"
								},
								"ContainerName": "source-files"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"parameters": {
			"ContainerName": {
				"type": "string"
			},
			"FolderPath": {
				"type": "string"
			}
		},
		"annotations": []
	}
}