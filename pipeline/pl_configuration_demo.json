{
	"name": "pl_configuration_demo",
	"properties": {
		"activities": [
			{
				"name": "Lookup configuration",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "dsrc_blob_config_json",
						"type": "DatasetReference",
						"parameters": {
							"container": "source-files",
							"file_name": "blob_config_file.json"
						}
					},
					"firstRowOnly": false
				}
			}
		],
		"folder": {
			"name": "configurable_pipelines"
		},
		"annotations": []
	}
}